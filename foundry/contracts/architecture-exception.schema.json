{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Foundry Factory Architecture Exception",
  "type": "object",
  "required": [
    "exception_id",
    "portfolio_id",
    "item_ids",
    "severity",
    "finding",
    "proposed_change",
    "status",
    "blocks_affected_items"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "item_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity": {
      "enum": [
        "MINOR",
        "MAJOR",
        "CRITICAL"
      ]
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "proposed_change": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "APPROVED",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "blocks_affected_items": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
