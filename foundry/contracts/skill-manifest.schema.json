{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Foundry Catalog Manifest",
  "type": "object",
  "required": ["id", "name", "version", "category", "purpose", "triggers", "non_triggers", "outputs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "triggers": {"type": "array", "items": {"type": "string"}},
    "non_triggers": {"type": "array", "items": {"type": "string"}},
    "minimum_inputs": {"type": "array", "items": {"type": "string"}},
    "optional_inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "handoffs_to": {"type": "array", "items": {"type": "string"}},
    "quality_gates": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
