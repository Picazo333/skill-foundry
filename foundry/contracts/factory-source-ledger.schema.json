{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Foundry Factory Source Ledger",
  "type": "object",
  "required": [
    "portfolio_id",
    "source_fragments"
  ],
  "properties": {
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "source_fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_ref",
          "disposition",
          "normalized_item_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "raw_label": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "NORMALIZED",
              "DUPLICATE",
              "IRRELEVANT_WITH_REASON",
              "UNRESOLVED"
            ]
          },
          "normalized_item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
