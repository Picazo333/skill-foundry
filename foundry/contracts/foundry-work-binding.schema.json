{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Work Binding v1",
  "type": "object",
  "required": [
    "binding_version",
    "noema_work_order_ref",
    "candidate_id",
    "gate_obligations"
  ],
  "properties": {
    "binding_version": {
      "const": 1
    },
    "noema_work_order_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "spec_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "foundry_state": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
