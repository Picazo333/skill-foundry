{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Foundry Factory Portfolio Item",
  "type": "object",
  "required": [
    "item_id",
    "title",
    "item_type",
    "disposition",
    "lifecycle",
    "effort",
    "risk",
    "source_refs",
    "dependencies"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "item_type": {
      "enum": [
        "WORKFLOW",
        "CAPABILITY",
        "SKILL_CANDIDATE",
        "DETERMINISTIC_UTILITY",
        "SHARED_CONTRACT",
        "TOOL_ADAPTER",
        "HUMAN_JUDGMENT",
        "UNKNOWN"
      ]
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "enum": [
        "PENDING",
        "REUSE",
        "EXTEND",
        "MODE",
        "DEPENDENT_SKILL",
        "NEW_SKILL",
        "NO_SKILL",
        "MERGED",
        "DEFERRED",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "target_skill_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "merged_into": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "enum": [
        "DISCOVERED",
        "PLANNED",
        "BUILDING",
        "AUDITING",
        "READY_FOR_PUBLISH",
        "PUBLISHED",
        "CLOSED",
        "DEFERRED",
        "UNRESOLVED",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "REUSE",
              "EXTEND",
              "MODE",
              "DEPENDENT_SKILL"
            ]
          }
        }
      },
      "then": {
        "required": [
          "target_skill_id"
        ],
        "properties": {
          "target_skill_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "MERGED"
          }
        }
      },
      "then": {
        "required": [
          "merged_into"
        ],
        "properties": {
          "merged_into": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
