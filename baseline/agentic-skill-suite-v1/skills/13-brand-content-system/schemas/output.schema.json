{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Content System — RUN_RESULT",
  "type": "object",
  "required": ["status", "summary", "artifacts", "unresolved", "handoff", "quality"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED"]
    },
    "summary": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CONTENT_SYSTEM.md",
          "CONTENT_PILLARS.md",
          "FORMAT_LIBRARY.md",
          "CONTENT_PIPELINE.md",
          "MEASUREMENT_MODEL.md"
        ]
      },
      "description": "On status COMPLETE, must contain all five."
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. pillar set locked, cadence locked, channel-role assignments locked."
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. production capacity not confirmed, a compliance question needing legal review."
    },
    "handoff": {
      "type": "object",
      "properties": {
        "next_skill": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "pillars_trace_to_strategy": { "type": "boolean" },
        "cadence_capacity_backed_or_flagged": { "type": "boolean" },
        "no_views_as_revenue": { "type": "boolean" },
        "channel_variants_defined": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETE" } } },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 5
          }
        }
      }
    }
  ]
}
