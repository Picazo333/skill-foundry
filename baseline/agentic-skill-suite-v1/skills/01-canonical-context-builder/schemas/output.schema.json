{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Context Builder — RUN_RESULT",
  "type": "object",
  "required": ["status", "summary", "artifacts", "unresolved", "handoff", "quality"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED"]
    },
    "summary": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PROJECT_CANON.md",
          "DECISION_REGISTER.md",
          "OPEN_LOOPS.md",
          "DEPRECATED_REGISTER.md",
          "NEXT_START_PROMPT.md"
        ]
      },
      "description": "On status COMPLETE, must contain all five."
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "next_skill": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "no_invented_facts": { "type": "boolean" },
        "no_hidden_conflicts": { "type": "boolean" },
        "handoff_self_sufficient": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETE" } } },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 5
          }
        }
      }
    }
  ]
}
