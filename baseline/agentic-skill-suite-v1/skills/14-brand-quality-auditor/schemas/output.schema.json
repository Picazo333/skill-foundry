{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Quality Auditor — RUN_RESULT",
  "type": "object",
  "required": ["status", "summary", "artifacts", "unresolved", "handoff", "quality"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED"]
    },
    "summary": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "BRAND_QA_REPORT.md",
          "FIX_LIST.md",
          "DRIFT_REGISTER.md"
        ]
      },
      "description": "On status COMPLETE, must contain all three. On BLOCKED, may be empty — a canon-gate failure produces no audit findings."
    },
    "findings": {
      "type": "array",
      "description": "Optional structured mirror of BRAND_QA_REPORT.md's per-rule classifications, for machine consumption.",
      "items": {
        "type": "object",
        "required": ["canon_rule", "classification", "citation"],
        "properties": {
          "canon_rule": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["PASS", "FIX", "POLISH", "DEFER"]
          },
          "citation": {
            "type": "string",
            "description": "Exact canon source/section the finding traces to. Must not be empty."
          },
          "note": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" },
      "description": "DEFER items and any missing-canon gaps that blocked full grading."
    },
    "handoff": {
      "type": "object",
      "properties": {
        "next_skill": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "canon_explicit_and_approved": { "type": "boolean" },
        "no_finding_without_canon_citation": { "type": "boolean" },
        "no_strategy_reopened": { "type": "boolean" },
        "fix_list_minimal": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETE" } } },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 3
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } } },
      "then": {
        "properties": {
          "unresolved": {
            "type": "array",
            "minItems": 1,
            "description": "A BLOCKED run must state exactly what canon is missing."
          }
        }
      }
    }
  ]
}
